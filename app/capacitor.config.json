{
  "appId": "de.preikschas.gainpilot",
  "appName": "GainPilot",
  "webDir": "www",
  "backgroundColor": "#111317",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": true,
      "backgroundColor": "#111317",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#C6F432"
    }
  }
}
