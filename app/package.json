{
  "name": "gainpilot-app",
  "version": "3.17.0",
  "private": true,
  "description": "Native Hülle (Capacitor) für GainPilot – Play Store und App Store",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "icons": "capacitor-assets generate --iconBackgroundColor \"#1c7a4b\" --iconBackgroundColorDark \"#0d1310\" --splashBackgroundColor \"#1c7a4b\" --splashBackgroundColorDark \"#0d1310\"",
    "sync": "npm run web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
